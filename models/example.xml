<mujoco model="minimal_pendulum">
  <compiler angle="radian"/>
  <option timestep="0.002" gravity="0 0 -9.81"/>

  <visual>
    <global azimuth="135" elevation="-20"/>
  </visual>

  <worldbody>
    <light pos="0 -2 3" dir="0 1 -1"/>
    <geom name="floor" type="plane" size="3 3 0.1" rgba="0.8 0.85 0.9 1"/>

    <body name="pendulum" pos="0 0 1.2">
      <joint name="hinge" type="hinge" axis="0 1 0" damping="0.2"/>
      <geom name="arm" type="capsule" fromto="0 0 0 0 0 -0.8"
            size="0.07" density="700" rgba="0.2 0.55 0.9 1"/>
      <geom name="weight" type="sphere" pos="0 0 -0.8"
            size="0.13" density="1200" rgba="0.95 0.35 0.2 1"/>
    </body>
  </worldbody>

  <actuator>
    <motor name="hinge_motor" joint="hinge" ctrlrange="-20 20"/>
  </actuator>
</mujoco>
